        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "{{service}} (5xx)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RED: 5xx Error Rate (errors/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
